---
import { Image } from "astro:assets";
import { getFeaturedProjects } from "../data/projects.js";

const featuredProjects = getFeaturedProjects();
---

<section id="proyectos" class="projects">
    <div class="container">
        <header class="section-header">
            <h2 class="section-title" data-animate="fade-up">
                <span class="title-bracket">[</span>
                Proyectos Destacados
                <span class="title-bracket">]</span>
            </h2>
            <p class="section-subtitle" data-animate="fade-up" data-delay="100">
                Soluciones reales construidas con pasión y tecnología
            </p>
        </header>

        <div class="projects-grid">
            {featuredProjects.map((project, index) => (
                <article
                    class={`project-card ${project.highlight ? 'featured' : ''}`}
                    data-animate="fade-up"
                    data-delay={project.highlight ? 200 : 100}
                >
                    <div class="project-image">
                        <Image
                            src={project.image}
                            alt={project.imageAlt}
                            width={project.highlight ? 500 : 400}
                            height={project.highlight ? 300 : 250}
                            loading="lazy"
                        />
                        <div class="project-overlay">
                            {project.links.length > 0 ? (
                                project.links.map((link) => (
                                    <a
                                        href={link.url}
                                        class="project-link demo-link"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {link.label}
                                    </a>
                                ))
                            ) : (
                                <a href={`/proyectos/${project.slug}`} class="project-link demo-link">
                                    Caso de Estudio
                                </a>
                            )}
                        </div>
                    </div>
                    <div class="project-info">
                        <div class="project-type">
                            {project.highlight ? '⭐ Proyecto Destacado' : project.category}
                        </div>
                        <h3 class="project-title">{project.title}</h3>
                        <p class="project-description">{project.description}</p>
                        <div class="project-tech">
                            {project.tech.map((tech) => (
                                <span class="tech-tag">{tech}</span>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>

        <div class="projects-cta" data-animate="fade-up" data-delay="700">
            <a href="/proyectos" class="btn-outline">
                Ver todos los proyectos
            </a>
        </div>
    </div>
</section>


